{
  "dataflows": [
    {
      "name": "prueba-acceso",
      "sources": [
        {
          "name": "person_inputs",
          "path": "data/input/events/person",
          "format": "JSON",
          "options": {},
          "preserveFieldOrder": true
        }
      ],
      "transformations": [
        {
          "name": "validation",
          "type": "validate_fields",
          "params": {
            "input": "person_inputs",
            "validations": [
              {
                "field": "office",
                "validations": [
                  "notEmpty"
                ]
              },
              {
                "field": "age",
                "validations": [
                  "notNull"
                ]
              }
            ]
          }
        },
        {
          "name": "ok_with_date",
          "type": "add_fields",
          "params": {
            "input": "validation_ok",
            "addFields": [
              {
                "name": "dt",
                "function": "current_timestamp",
                "format": "yyyy-MM-dd HH:mm:ss"
              }
            ]
          }
        },
        {
          "name": "ko_with_date",
          "type": "add_fields",
          "params": {
            "input": "validation_ko",
            "addFields": [
              {
                "name": "dt",
                "function": "current_timestamp",
                "format": "yyyy-MM-dd HH:mm:ss"
              }
            ]
          }
        }
      ],
      "sinks": [
        {
          "input": "ok_with_date",
          "name": "raw-ok",
          "paths": [
            "data/output/events/person"
          ],
          "format": "JSON",
          "saveMode": "OVERWRITE",
          "publication": {}
        },
        {
          "input": "ko_with_date",
          "name": "raw-ko",
          "paths": [
            "data/output/discards/person"
          ],
          "format": "JSON",
          "saveMode": "OVERWRITE",
          "publication": {},
          "options": {
            "ignoreNullFields": "false"
          }
        }
      ]
    }
  ]
}
